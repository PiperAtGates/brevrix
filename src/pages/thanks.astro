---
import Layout from '../layouts/Layout.astro';
import { CheckCircle2, Calendar, Mail, ArrowRight, ShieldCheck, Home } from '@lucide/astro';
---

<Layout
  title="Inquiry Received | Brevrix"
  description="Thank you for reaching out to Brevrix. We have received your project details and will respond within 12 to 24 hours."
  currentPath="/thanks"
  robots="noindex, follow"
>
  <section class="py-20 md:py-32 relative overflow-hidden">
    <!-- Ambient glow -->
    <div class="absolute top-1/3 left-1/2 -translate-x-1/2 -translate-y-1/2 w-96 h-96 bg-emerald-500/10 rounded-full blur-3xl pointer-events-none"></div>

    <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10 text-center">
      
      <!-- Success Icon -->
      <div class="w-20 h-20 rounded-3xl bg-emerald-500/10 border border-emerald-500/20 text-emerald-400 flex items-center justify-center mx-auto mb-8 shadow-xl shadow-emerald-500/10 animate-bounce">
        <CheckCircle2 class="w-10 h-10" />
      </div>

      <!-- Heading -->
      <span class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-emerald-500/10 border border-emerald-500/20 text-emerald-400 text-xs font-mono mb-4">
        Inquiry Successfully Received
      </span>
      <h1 class="text-3xl sm:text-5xl font-extrabold text-white tracking-tight">
        Thank You for Reaching Out
      </h1>
      <p class="text-slate-300 text-base sm:text-lg mt-4 max-w-xl mx-auto leading-relaxed">
        We have received your project requirements. Our engineering team reviews all briefs personally and will get back to you within <span class="text-white font-semibold">12 to 24 hours</span> with technical scoping feedback.
      </p>

      <!-- Next Steps Cards -->
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-5 mt-10 text-left">
        
        <!-- Cal.com Card -->
        <div class="glass-card rounded-2xl p-6 border border-white/10 flex flex-col justify-between hover:border-indigo-500/30 transition-all">
          <div>
            <div class="w-10 h-10 rounded-xl bg-indigo-500/10 border border-indigo-500/20 text-indigo-400 flex items-center justify-center mb-4">
              <Calendar class="w-5 h-5" />
            </div>
            <h3 class="text-base font-bold text-white mb-1">Want to Talk Sooner?</h3>
            <p class="text-xs text-slate-400 leading-relaxed">
              Skip the email thread and reserve a focused 20-minute video intro directly on our calendar.
            </p>
          </div>
          <div class="pt-5 mt-4 border-t border-white/5">
            <a
              href="https://cal.com/brevrix"
              target="_blank"
              rel="noopener noreferrer"
              class="w-full py-2.5 px-4 rounded-xl bg-indigo-600 hover:bg-indigo-500 text-white font-semibold text-xs transition-colors flex items-center justify-center gap-2"
            >
              <span>Book 20-min Call</span>
              <ArrowRight class="w-3.5 h-3.5" />
            </a>
          </div>
        </div>

        <!-- Direct Email Card -->
        <div class="glass-card rounded-2xl p-6 border border-white/10 flex flex-col justify-between hover:border-white/20 transition-all">
          <div>
            <div class="w-10 h-10 rounded-xl bg-sky-500/10 border border-sky-500/20 text-sky-400 flex items-center justify-center mb-4">
              <Mail class="w-5 h-5" />
            </div>
            <h3 class="text-base font-bold text-white mb-1">Direct Engineering Desk</h3>
            <p class="text-xs text-slate-400 leading-relaxed">
              Have architectural diagrams, NDA drafts, or existing repos to share? Send them directly to our inbox.
            </p>
          </div>
          <div class="pt-5 mt-4 border-t border-white/5">
            <a
              href="mailto:hello@brevrix.com"
              class="w-full py-2.5 px-4 rounded-xl bg-white/5 hover:bg-white/10 border border-white/10 text-white font-semibold text-xs transition-colors flex items-center justify-center gap-2"
            >
              <span>hello@brevrix.com</span>
              <ArrowRight class="w-3.5 h-3.5" />
            </a>
          </div>
        </div>

      </div>

      <!-- Trust Note & Back Home -->
      <div class="mt-12 flex flex-col sm:flex-row items-center justify-center gap-6 text-xs text-slate-400">
        <div class="flex items-center gap-2">
          <ShieldCheck class="w-4 h-4 text-emerald-400" />
          <span>All client communications are strictly confidential under mutual NDA</span>
        </div>
        <a
          href="/"
          class="inline-flex items-center gap-2 text-indigo-400 hover:text-indigo-300 font-semibold"
        >
          <Home class="w-4 h-4" />
          <span>Return to Homepage</span>
        </a>
      </div>

    </div>
  </section>
</Layout>
