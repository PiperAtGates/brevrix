---
import { getCollection, render } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import { ArrowLeft, ArrowRight, Calendar, User, Zap, ShieldCheck, Linkedin, Github } from '@lucide/astro';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map((post) => ({
    params: { slug: post.id },
    props: post,
  }));
}

const post = Astro.props;
const { Content } = await render(post);

const authorBio = "Founder & Principal Systems/DevOps Engineer at Brevrix with extensive enterprise experience in Linux administration, Kubernetes (k8s/k3s), Docker, ArgoCD, GitLab CI, and high-availability database architectures (PostgreSQL, ClickHouse, Redis).";

const pageTitle = post.data.title.includes('Brevrix') ? post.data.title : `${post.data.title} | Brevrix`;
---

<Layout 
  title={pageTitle}
  description={post.data.description}
  articleDate={post.data.pubDate.toISOString()}
  authorName={post.data.author}
  currentPath="/blog"
>
  <article class="max-w-3xl mx-auto px-6 py-16">
    <div class="mb-10">
      
      <!-- Breadcrumb Navigation -->
      <nav class="flex items-center gap-2 text-xs font-mono text-slate-400 mb-6">
        <a href="/" class="hover:text-white transition-colors">Home</a>
        <span>/</span>
        <a href="/blog" class="hover:text-white transition-colors">Blog</a>
        <span>/</span>
        <span class="text-indigo-400 truncate max-w-[200px] sm:max-w-xs">{post.data.category}</span>
      </nav>

      <a href="/blog" class="inline-flex items-center gap-1.5 text-xs font-mono text-sky-400 hover:text-sky-300 transition-colors mb-6 group">
        <ArrowLeft class="w-3.5 h-3.5 group-hover:-translate-x-1 transition-transform" />
        <span>Back to all engineering articles</span>
      </a>
      
      <div class="flex items-center gap-3 text-xs text-slate-400 mb-4">
        <span class="px-3 py-1 rounded-full bg-indigo-500/10 text-indigo-400 border border-indigo-500/20 font-mono text-[11px]">
          {post.data.category}
        </span>
        <span>•</span>
        <time datetime={post.data.pubDate.toISOString()}>
          {post.data.pubDate.toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric' })}
        </time>
        {post.data.updatedDate && (
          <>
            <span>•</span>
            <span class="text-emerald-400 font-mono text-[11px]">Updated {post.data.updatedDate.toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' })}</span>
          </>
        )}
      </div>

      <h1 class="text-3xl md:text-5xl font-extrabold text-white leading-tight mb-6 font-heading">
        {post.data.title}
      </h1>
    </div>

    <!-- AI Search / Quick Takeaway Box (GEO & AI Answer Engine Optimized) -->
    {post.data.aiSummary && (
      <div class="bg-indigo-950/40 border border-indigo-500/30 rounded-2xl p-6 sm:p-7 mb-10 backdrop-blur-sm">
        <div class="flex items-center gap-2 text-xs font-bold uppercase tracking-wider text-indigo-300 mb-2 font-mono">
          <Zap class="w-4 h-4 text-sky-400" />
          <span>Executive Summary / Direct Solution (AI Reference)</span>
        </div>
        <p class="text-slate-200 text-sm leading-relaxed">
          {post.data.aiSummary}
        </p>
      </div>
    )}

    <!-- Main Article Markdown Content -->
    <div class="prose prose-invert max-w-none text-slate-300 leading-relaxed space-y-6 [&>h2]:text-2xl [&>h2]:font-bold [&>h2]:text-white [&>h2]:pt-6 [&>h3]:text-xl [&>h3]:font-semibold [&>h3]:text-slate-100 [&>h3]:pt-4 [&>ul]:list-disc [&>ul]:pl-5 [&>ul]:space-y-2 [&>code]:bg-white/10 [&>code]:px-1.5 [&>code]:py-0.5 [&>code]:rounded [&>code]:font-mono [&>code]:text-sky-300 [&>pre]:bg-slate-900/90 [&>pre]:border [&>pre]:border-white/10 [&>pre]:rounded-2xl [&>pre]:p-5 [&>pre]:overflow-x-auto">
      <Content />
    </div>

    <!-- Verified Author E-E-A-T Trust Box -->
    <div class="mt-16 p-6 sm:p-8 rounded-2xl glass-card border border-white/10 flex flex-col sm:flex-row gap-6 items-start sm:items-center justify-between">
      <div class="space-y-2">
        <div class="text-[11px] uppercase tracking-wider text-sky-400 font-semibold font-mono flex items-center gap-1.5">
          <ShieldCheck class="w-3.5 h-3.5" />
          <span>Verified Technical Author</span>
        </div>
        <h3 class="text-xl font-bold text-white">{post.data.author}</h3>
        <p class="text-slate-400 text-xs sm:text-sm max-w-lg leading-relaxed">{authorBio}</p>
        
        <!-- Author Profiles -->
        <div class="flex items-center gap-3 pt-1">
          <a
            href="https://www.linkedin.com/in/sadia-lubna/"
            target="_blank"
            rel="noopener noreferrer"
            class="text-xs text-indigo-400 hover:text-indigo-300 inline-flex items-center gap-1 font-mono"
          >
            <span>LinkedIn Profile</span>
            <span>↗</span>
          </a>
          <span class="text-slate-600">•</span>
          <a
            href="https://github.com/PiperAtGates"
            target="_blank"
            rel="noopener noreferrer"
            class="text-xs text-sky-400 hover:text-sky-300 inline-flex items-center gap-1 font-mono"
          >
            <span>GitHub</span>
            <span>↗</span>
          </a>
        </div>
      </div>

      <div class="flex flex-col gap-2 w-full sm:w-auto shrink-0">
        <a
          href="/contact"
          class="px-6 py-3 rounded-xl bg-gradient-to-r from-sky-500 to-indigo-600 hover:from-sky-400 hover:to-indigo-500 text-white text-xs font-semibold text-center transition-all shadow-lg shadow-indigo-500/25"
        >
          Consult with Sadia
        </a>
        <a
          href="https://cal.com/brevrix"
          target="_blank"
          rel="noopener noreferrer"
          class="px-6 py-2.5 rounded-xl bg-white/5 hover:bg-white/10 border border-white/10 text-white text-xs font-medium text-center transition-colors"
        >
          Book 20-min Call
        </a>
      </div>
    </div>
  </article>
</Layout>
