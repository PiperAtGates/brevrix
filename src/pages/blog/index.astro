---
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';
import { ArrowRight, BookOpen, Clock, User, Sparkles } from '@lucide/astro';

const posts = (await getCollection('blog')).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);
---

<Layout 
  title="Engineering & Digital Growth Blog | Brevrix" 
  description="In-depth tutorials, DevOps troubleshooting guides, Kubernetes architecture, and technical SEO strategies by the Brevrix engineering team."
  currentPath="/blog"
>
  <section class="max-w-6xl mx-auto px-6 py-16">
    <div class="text-center max-w-3xl mx-auto mb-16">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-indigo-500/10 border border-indigo-500/20 text-indigo-400 text-xs font-mono mb-4">
        <Sparkles class="w-3.5 h-3.5" />
        <span>Technical Insights & Tutorials</span>
      </div>
      <h1 class="text-4xl md:text-5xl font-extrabold mt-2 mb-6 tracking-tight text-white font-heading">
        Brevrix <span class="gradient-accent">Engineering Hub</span>
      </h1>
      <p class="text-slate-400 text-base md:text-lg leading-relaxed">
        Real-world enterprise guides on Kubernetes, Linux servers, Astro web performance, and data-driven digital growth.
      </p>
    </div>

    <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-8">
      {posts.map((post) => (
        <article class="glass-card glass-card-hover rounded-2xl p-6 border border-white/10 flex flex-col justify-between group">
          <div>
            <div class="flex items-center justify-between text-xs text-slate-400 mb-4">
              <span class="px-2.5 py-1 rounded-lg bg-sky-500/10 text-sky-400 border border-sky-500/20 font-medium font-mono text-[11px]">
                {post.data.category}
              </span>
              <time datetime={post.data.pubDate.toISOString()} class="text-slate-500 text-xs">
                {post.data.pubDate.toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' })}
              </time>
            </div>
            
            <h2 class="text-xl font-bold text-white mb-3 group-hover:text-sky-300 transition-colors">
              <a href={`/blog/${post.id}/`}>{post.data.title}</a>
            </h2>
            
            <p class="text-slate-400 text-sm line-clamp-3 mb-6 leading-relaxed">
              {post.data.description}
            </p>
          </div>

          <div class="pt-4 border-t border-white/5 flex items-center justify-between text-xs">
            <span class="text-slate-300 font-medium">By {post.data.author}</span>
            <a href={`/blog/${post.id}/`} class="text-indigo-400 font-semibold group-hover:text-sky-300 inline-flex items-center gap-1 transition-all">
              <span>Read Guide</span>
              <ArrowRight class="w-3.5 h-3.5 group-hover:translate-x-1 transition-transform" />
            </a>
          </div>
        </article>
      ))}
    </div>
  </section>
</Layout>

