---
import Layout from '../layouts/Layout.astro';
import CtaBanner from '../components/CtaBanner.astro';
import { servicesData } from '../data/services';
import { ArrowRight, CheckCircle2, Code2, Palette, Cloud, Sparkles, Zap, Smartphone, Database, FileSpreadsheet, Check, Clock, DollarSign } from '@lucide/astro';

const serviceIcons: Record<string, any> = {
  Code2,
  Palette,
  Cloud,
  Sparkles,
  Zap,
  Smartphone,
  Database,
  FileSpreadsheet
};
---

<Layout
  title="Services | DevOps, Web, Databases & AI — Brevrix"
  description="DevOps & Kubernetes, Astro/WordPress development, database operations, and AI automation — fixed-scope services from Brevrix with transparent pricing."
  currentPath="/services"
>
  <!-- Page Header -->
  <section class="py-16 md:py-24 relative overflow-hidden">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10 text-center max-w-4xl mx-auto">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-sky-500/10 border border-sky-500/20 text-sky-400 text-xs font-mono mb-4">
        <span>Comprehensive Service Suite</span>
      </div>
      <h1 class="text-4xl sm:text-6xl font-extrabold text-white tracking-tight">
        Engineered for Maximum Impact & Conversions
      </h1>
      <p class="text-slate-400 text-lg sm:text-xl mt-4 leading-relaxed">
        Transparent deliverables, modern technology choices, and fixed milestone execution. Select a service below to explore specifications or book a sprint.
      </p>
    </div>
  </section>

  <!-- Detailed Services List -->
  <section class="pb-24 relative z-10">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 space-y-16">
      
      {servicesData.map((service, index) => {
        const Icon = serviceIcons[service.iconName] || Code2;
        const isReversed = index % 2 === 1;

        return (
          <div
            id={service.id}
            class="glass-card rounded-3xl p-8 sm:p-12 border border-white/10 hover:border-indigo-500/30 transition-all duration-300 relative overflow-hidden"
          >
            <!-- Ambient glow behind card -->
            <div class="absolute -right-20 -bottom-20 w-80 h-80 bg-indigo-500/10 rounded-full blur-3xl pointer-events-none"></div>

            <div class={`grid grid-cols-1 lg:grid-cols-12 gap-10 items-center ${isReversed ? 'lg:flex-row-reverse' : ''}`}>
              
              <!-- Left / Main Description (7 cols) -->
              <div class="lg:col-span-7 space-y-6">
                
                <div class="flex items-center gap-3">
                  <div class="w-12 h-12 rounded-2xl bg-indigo-500/20 border border-indigo-500/30 flex items-center justify-center text-indigo-400">
                    <Icon class="w-6 h-6" />
                  </div>
                  <span class="text-xs font-mono px-3 py-1 rounded-full bg-white/5 text-slate-300 border border-white/10">
                    {service.badge}
                  </span>
                </div>

                <h2 class="text-2xl sm:text-3xl font-extrabold text-white">
                  {service.title}
                </h2>

                <p class="text-slate-300 text-base leading-relaxed">
                  {service.longDesc}
                </p>

                <!-- Deliverables list -->
                <div class="pt-2 space-y-3">
                  <h4 class="text-xs font-mono uppercase tracking-wider text-indigo-400">What You Receive (Deliverables):</h4>
                  <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
                    {service.deliverables.map((deliv) => (
                      <div class="p-3 rounded-xl bg-white/[0.03] border border-white/5">
                        <div class="flex items-center gap-2 text-sm font-semibold text-white">
                          <CheckCircle2 class="w-4 h-4 text-emerald-400 flex-shrink-0" />
                          <span>{deliv.title}</span>
                        </div>
                        <p class="text-xs text-slate-400 mt-1 pl-6">{deliv.desc}</p>
                      </div>
                    ))}
                  </div>
                </div>

                <!-- Tech stack -->
                <div class="pt-2">
                  <span class="text-xs font-mono uppercase tracking-wider text-slate-500 block mb-2">Technologies Used:</span>
                  <div class="flex flex-wrap gap-2">
                    {service.techStack.map((tech) => (
                      <span class="text-xs font-mono px-3 py-1 rounded-lg bg-white/[0.04] text-slate-300 border border-white/5">
                        {tech}
                      </span>
                    ))}
                  </div>
                </div>

              </div>

              <!-- Right / Summary Box (5 cols) -->
              <div class="lg:col-span-5 bg-gradient-to-b from-white/[0.05] to-white/[0.02] rounded-2xl p-6 sm:p-8 border border-white/10 flex flex-col justify-between space-y-6">
                
                <div>
                  <div class="text-xs font-mono uppercase text-slate-400 mb-1">Standard Investment</div>
                  <div class="text-3xl sm:text-4xl font-black text-white font-heading">
                    {service.startingPrice}
                  </div>
                  <span class="text-xs text-slate-400 block mt-1">Starting baseline • Clear milestone phases</span>
                </div>

                <div class="space-y-3 py-4 border-y border-white/10 text-xs">
                  <div class="flex items-center justify-between">
                    <span class="text-slate-400 flex items-center gap-1.5">
                      <Clock class="w-4 h-4 text-sky-400" />
                      Typical Turnaround:
                    </span>
                    <span class="font-bold text-white">{service.turnaroundTime}</span>
                  </div>

                  <div class="flex items-center justify-between">
                    <span class="text-slate-400 flex items-center gap-1.5">
                      <Zap class="w-4 h-4 text-amber-400" />
                      {service.highlightStats.label}:
                    </span>
                    <span class="font-bold text-emerald-400">{service.highlightStats.value}</span>
                  </div>

                  <div class="flex items-center justify-between">
                    <span class="text-slate-400">Deployment Target:</span>
                    <span class="font-medium text-slate-200">Cloudflare Pages & Linux Edge</span>
                  </div>
                </div>

                <div class="space-y-3">
                  <a
                    href={`/contact?service=${service.id}`}
                    class="w-full py-3.5 px-4 rounded-xl bg-gradient-to-r from-sky-500 via-indigo-600 to-purple-600 hover:from-sky-400 hover:to-purple-500 text-white font-semibold text-sm transition-all duration-200 flex items-center justify-center gap-2 shadow-lg shadow-indigo-500/25"
                  >
                    <span>Inquire About {service.title}</span>
                    <ArrowRight class="w-4 h-4" />
                  </a>

                  <a
                    href="/#estimator"
                    class="w-full py-2.5 px-4 rounded-xl bg-white/5 hover:bg-white/10 text-slate-300 text-xs font-medium transition-all text-center block border border-white/5"
                  >
                    Customize in Project Estimator
                  </a>
                </div>

              </div>

            </div>

          </div>
        );
      })}

    </div>
  </section>

  <!-- Bottom CTA Banner -->
  <CtaBanner />
</Layout>

