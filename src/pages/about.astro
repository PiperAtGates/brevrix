---
import Layout from '../layouts/Layout.astro';
import CtaBanner from '../components/CtaBanner.astro';
import ProcessWorkflow from '../components/ProcessWorkflow.astro';
import { ShieldCheck, Cpu, Code2, Sparkles, Terminal, HeartHandshake, CheckCircle2, ArrowRight, Layers, Database, Lock, Mail, ExternalLink } from '@lucide/astro';

const technicalLead = {
  name: "Sadia Afrin Lubna",
  title: "Founder & Principal Systems/DevOps Engineer",
  education: "BSc in Computer Science & Engineering (CSE) — IUBAT",
  bio: "Experienced Systems Engineer with extensive hands-on experience architecting, managing, and troubleshooting mission-critical applications across Development, UAT, and Production environments. Specializes in production-grade Linux servers, Kubernetes (k8s/k3s) cluster orchestration, automated GitOps CI/CD pipelines (ArgoCD, Jenkins, GitLab CI), high-throughput data layers (PostgreSQL, ClickHouse, Redis), and practical AI model inference pipelines.",
  coreStack: [
    "Kubernetes (k8s/k3s/Helm)",
    "Docker & Linux (Ubuntu/RHEL)",
    "ArgoCD & Jenkins CI/CD",
    "PostgreSQL, Redis & ClickHouse",
    "Kong API Gateway & Keycloak",
    "Python, YOLOv5 & OpenCV",
    "Trivy Security Scanning"
  ],
  links: {
    linkedin: "https://www.linkedin.com/in/sadia-lubna/",
    github: "https://github.com/sadia-lubna",
    email: "mailto:sadialubnaa@gmail.com"
  }
};

const studioCapabilities = [
  {
    title: "Enterprise Systems & Cloud Infrastructure",
    lead: "Infrastructure Practice",
    desc: "Production-tested Linux administration, Kubernetes cluster lifecycle management, automated zero-downtime CI/CD deployments, and enterprise security hardening.",
    icon: Terminal
  },
  {
    title: "High-Performance Web & CMS Engineering",
    lead: "Web Engineering Practice",
    desc: "Sub-second Astro static platforms, custom WordPress business systems, and headless architectures achieving 100/100 Lighthouse performance.",
    icon: Code2
  },
  {
    title: "Distributed Data & Messaging Systems",
    lead: "Data Architecture Practice",
    desc: "Relational tuning (PostgreSQL, MySQL), low-latency analytical stores (ClickHouse), Redis caching layers, and asynchronous messaging (Kafka/RabbitMQ).",
    icon: Database
  },
  {
    title: "Accountable Delivery & Project Governance",
    lead: "Operations & Quality Assurance",
    desc: "Rigorous milestone tracking, structured documentation, SLA guarantees, and transparent financial reporting backed by disciplined business management.",
    icon: ShieldCheck
  }
];

const comparisons = [
  {
    feature: "Direct Technical Access",
    brevrix: "Direct collaboration with the Principal Engineer architecting your systems",
    agency: "Filtered through layers of junior account managers and non-technical coordinators",
  },
  {
    feature: "Infrastructure & Reliability",
    brevrix: "Production-grade Kubernetes, Linux servers, CI/CD GitOps, and 99.99% SLA",
    agency: "Standard shared cPanel hosting with slow performance and zero containerization",
  },
  {
    feature: "Code Quality & Modern Tech",
    brevrix: "Astro, TypeScript, Tailwind, Edge Cloudflare deployments",
    agency: "Bloated themes, heavy unmaintained plugins, and sluggish database queries",
  },
  {
    feature: "Accountability & Documentation",
    brevrix: "Disciplined milestone delivery, comprehensive architectural docs, transparent reporting",
    agency: "Ambiguous billable hours with unexpected extra fees and poor handover",
  },
  {
    feature: "IP & Repository Handover",
    brevrix: "100% full transfer of repositories, container configs, and production assets",
    agency: "Complex retainers or proprietary vendor lock-in contracts",
  }
];
---

<Layout 
  title="About Brevrix | Boutique Engineering & Infrastructure Studio" 
  description="Discover Brevrix: an elite engineering studio founded and led by Sadia Afrin Lubna, delivering enterprise DevOps, Kubernetes, and high-performance web systems."
  currentPath="/about"
>
  <section class="max-w-6xl mx-auto px-6 py-16">
    <!-- Trust Header -->
    <div class="max-w-3xl mb-16">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-sky-500/10 text-sky-400 border border-sky-500/20 text-xs font-mono mb-4">
        <span>The Brevrix Philosophy</span>
      </div>
      <h1 class="text-4xl md:text-5xl font-extrabold text-white mt-2 mb-6 leading-tight font-heading">
        Enterprise Engineering Meets <br />
        <span class="gradient-accent">Boutique Craftsmanship.</span>
      </h1>
      <p class="text-slate-300 text-base md:text-lg leading-relaxed">
        Brevrix is an independent engineering and systems architecture studio. We partner directly with technical founders, CTOs, and scaling companies to deliver production-grade infrastructure, high-converting web platforms, and reliable distributed systems.
      </p>
    </div>

    <!-- Trust Pillars -->
    <div class="grid md:grid-cols-3 gap-6 mb-20">
      <div class="glass-card rounded-2xl p-6 border border-white/10 hover:border-sky-500/40 transition-all">
        <div class="text-2xl font-extrabold text-sky-400 mb-2 font-heading">99.99% Reliability</div>
        <h3 class="text-lg font-bold text-white mb-2">Production-Tested DevOps</h3>
        <p class="text-slate-400 text-xs sm:text-sm leading-relaxed">Our infrastructure workflows are backed by hands-on enterprise experience supporting live UAT and Production systems.</p>
      </div>
      <div class="glass-card rounded-2xl p-6 border border-white/10 hover:border-indigo-500/40 transition-all">
        <div class="text-2xl font-extrabold text-indigo-400 mb-2 font-heading">100/100 Speed</div>
        <h3 class="text-lg font-bold text-white mb-2">Modern Web Architecture</h3>
        <p class="text-slate-400 text-xs sm:text-sm leading-relaxed">We build on Astro, Tailwind, and Cloudflare Edge networks that pass Google Core Web Vitals effortlessly.</p>
      </div>
      <div class="glass-card rounded-2xl p-6 border border-white/10 hover:border-emerald-500/40 transition-all">
        <div class="text-2xl font-extrabold text-emerald-400 mb-2 font-heading">Zero Compromise</div>
        <h3 class="text-lg font-bold text-white mb-2">Principal-Led Execution</h3>
        <p class="text-slate-400 text-xs sm:text-sm leading-relaxed">No junior handoffs. Every architecture decision is designed, verified, and audited by our Principal Engineer.</p>
      </div>
    </div>

    <!-- Founder & Technical Lead Spotlight -->
    <div class="mb-20">
      <div class="mb-8">
        <div class="text-xs font-mono uppercase tracking-wider text-sky-400 mb-2">Principal Technical Leadership</div>
        <h2 class="text-3xl font-extrabold text-white font-heading">Meet Our Technical Director</h2>
      </div>

      <div class="glass-card rounded-3xl p-8 sm:p-12 border border-white/10 relative overflow-hidden group hover:border-sky-500/40 transition-all">
        <!-- Ambient corner glow -->
        <div class="absolute -right-20 -bottom-20 w-80 h-80 bg-sky-500/10 rounded-full blur-3xl pointer-events-none"></div>

        <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start relative z-10">
          <div class="lg:col-span-8 space-y-4">
            <div class="flex flex-wrap items-center gap-3">
              <h3 class="text-3xl font-bold text-white font-heading">{technicalLead.name}</h3>
              <span class="px-3 py-1 rounded-full text-xs font-mono bg-sky-500/10 text-sky-300 border border-sky-500/20">
                Founder & Technical Lead
              </span>
            </div>

            <p class="text-xs text-slate-400 font-mono pb-2 border-b border-white/5">
              {technicalLead.education}
            </p>

            <p class="text-slate-300 text-sm sm:text-base leading-relaxed pt-2">
              {technicalLead.bio}
            </p>

            <div class="pt-4">
              <span class="text-xs font-mono uppercase tracking-wider text-slate-400 block mb-3">Core Engineering Arsenal:</span>
              <div class="flex flex-wrap gap-2">
                {technicalLead.coreStack.map((tech) => (
                  <span class="px-3 py-1 rounded-lg bg-white/5 text-slate-300 border border-white/10 text-xs font-mono">
                    {tech}
                  </span>
                ))}
              </div>
            </div>
          </div>

          <div class="lg:col-span-4 bg-white/[0.02] p-6 rounded-2xl border border-white/5 space-y-5">
            <h4 class="text-xs font-mono uppercase tracking-wider text-slate-400">Direct Verification & Contact</h4>
            
            <div class="space-y-3 text-xs">
              <a
                href={technicalLead.links.linkedin}
                target="_blank"
                rel="noopener noreferrer"
                class="flex items-center justify-between p-3 rounded-xl bg-white/[0.03] hover:bg-white/[0.08] text-slate-200 border border-white/5 transition-all group/link"
              >
                <span>LinkedIn Profile</span>
                <span class="text-sky-400 group-hover/link:translate-x-1 transition-transform">↗</span>
              </a>

              <a
                href={technicalLead.links.github}
                target="_blank"
                rel="noopener noreferrer"
                class="flex items-center justify-between p-3 rounded-xl bg-white/[0.03] hover:bg-white/[0.08] text-slate-200 border border-white/5 transition-all group/link"
              >
                <span>GitHub Repositories</span>
                <span class="text-sky-400 group-hover/link:translate-x-1 transition-transform">↗</span>
              </a>

              <a
                href={technicalLead.links.email}
                class="flex items-center justify-between p-3 rounded-xl bg-white/[0.03] hover:bg-white/[0.08] text-slate-200 border border-white/5 transition-all group/link"
              >
                <span class="font-mono text-sky-300">sadialubnaa@gmail.com</span>
                <span class="text-sky-400 group-hover/link:translate-x-1 transition-transform">↗</span>
              </a>
            </div>

            <div class="pt-2">
              <a
                href="/contact"
                class="w-full py-3 px-4 rounded-xl bg-gradient-to-r from-sky-500 to-indigo-600 hover:from-sky-400 hover:to-indigo-500 text-white font-semibold text-xs flex items-center justify-center gap-2 transition-all shadow-lg shadow-indigo-500/25"
              >
                <span>Consult with Sadia</span>
                <ArrowRight class="w-3.5 h-3.5" />
              </a>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- Studio Capabilities Matrix -->
    <div class="mb-20">
      <div class="mb-8">
        <div class="text-xs font-mono uppercase tracking-wider text-indigo-400 mb-2">Multi-Disciplinary Delivery</div>
        <h2 class="text-3xl font-extrabold text-white font-heading">Our Studio Practice Areas</h2>
      </div>

      <div class="grid md:grid-cols-2 gap-6">
        {studioCapabilities.map((cap) => {
          const Icon = cap.icon;
          return (
            <div class="glass-card rounded-2xl p-7 border border-white/10 hover:border-indigo-500/30 transition-all">
              <div class="flex items-center gap-3 mb-4">
                <div class="w-10 h-10 rounded-xl bg-indigo-500/20 border border-indigo-500/30 flex items-center justify-center text-indigo-400">
                  <Icon class="w-5 h-5" />
                </div>
                <div>
                  <span class="text-[10px] font-mono uppercase tracking-wider text-sky-400 block">{cap.lead}</span>
                  <h3 class="text-lg font-bold text-white">{cap.title}</h3>
                </div>
              </div>
              <p class="text-slate-400 text-xs sm:text-sm leading-relaxed">{cap.desc}</p>
            </div>
          );
        })}
      </div>
    </div>

    <!-- Comparison: Brevrix vs Traditional Agency -->
    <div class="mb-20">
      <div class="text-center mb-10">
        <h2 class="text-2xl sm:text-3xl font-bold text-white font-heading">
          Why Founders Choose Brevrix Over Traditional Agencies
        </h2>
        <p class="text-slate-400 text-xs sm:text-sm mt-2">
          Side-by-side comparison of execution, engineering depth, and partnership.
        </p>
      </div>

      <div class="glass-card rounded-2xl border border-white/10 overflow-hidden shadow-2xl">
        <div class="overflow-x-auto">
          <table class="w-full text-left text-xs sm:text-sm">
            <thead class="bg-white/[0.03] border-b border-white/10 text-slate-400 uppercase font-mono text-[11px]">
              <tr>
                <th class="py-4 px-6">Criteria</th>
                <th class="py-4 px-6 text-sky-400 font-bold bg-indigo-500/10">Brevrix Studio</th>
                <th class="py-4 px-6 text-slate-500">Traditional Agency</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-white/5 text-slate-300">
              {comparisons.map((row) => (
                <tr class="hover:bg-white/[0.02] transition-colors">
                  <td class="py-4 px-6 font-semibold text-white">{row.feature}</td>
                  <td class="py-4 px-6 font-medium text-slate-200 bg-indigo-500/[0.03]">
                    <div class="flex items-center gap-2">
                      <CheckCircle2 class="w-4 h-4 text-emerald-400 flex-shrink-0" />
                      <span>{row.brevrix}</span>
                    </div>
                  </td>
                  <td class="py-4 px-6 text-slate-500">{row.agency}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </div>
    </div>
  </section>

  <!-- Workflow Framework -->
  <ProcessWorkflow />

  <!-- Bottom CTA -->
  <CtaBanner />
</Layout>
