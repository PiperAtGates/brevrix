---
import { ShieldCheck, CheckCircle2, Gauge, GitBranch, Cpu, Lock, ArrowUpRight, ExternalLink } from '@lucide/astro';

const proofPoints = [
  {
    icon: Gauge,
    title: "100/100 Core Web Vitals",
    description: "Every web platform we engineer achieves top-tier scores on Google PageSpeed. Zero client-side bloat, aggressive image optimization, and sub-50ms TTFB across Cloudflare's global edge network.",
    badge: "Verified Performance",
    actionLink: "https://pagespeed.web.dev/analysis?url=https%3A%2F%2Fbrevrix.com",
    actionText: "Verify on PageSpeed"
  },
  {
    icon: GitBranch,
    title: "Auditable GitHub Repositories",
    description: "We don't hide behind black boxes. Review our clean Astro code, CI/CD pipeline automation, and strict TypeScript types directly in our public repositories.",
    badge: "Open Diligence",
    actionLink: "https://github.com/PiperAtGates/brevrix",
    actionText: "Inspect GitHub Source"
  },
  {
    icon: Lock,
    title: "100% Code & IP Ownership",
    description: "You retain full copyright and complete intellectual property ownership. Git repositories, environment configurations, and production keys are handed over cleanly upon project completion.",
    badge: "Zero Lock-in"
  },
  {
    icon: ShieldCheck,
    title: "30-Day Bug Warranty",
    description: "Every deployment includes a 30-day post-launch warranty period. Any defects, edge-case regressions, or configuration issues within scope are fixed immediately at zero additional cost.",
    badge: "Risk-Free Handover"
  },
  {
    icon: Cpu,
    title: "Automated Staging Previews",
    description: "Never guess what is being built. Every feature branch automatically generates an isolated preview URL so you can test interactive workflows before anything touches production.",
    badge: "CI/CD Precision"
  },
  {
    icon: CheckCircle2,
    title: "Fixed-Scope Milestone Billing",
    description: "Transparent 50% kickoff and 50% final inspection structure. Predictable budgets, verified scope boundaries, and zero surprise billable hours.",
    badge: "Predictable Investment"
  }
];
---

<section class="py-20 relative overflow-hidden bg-slate-950/40 border-y border-white/5">
  <!-- Subtle background glow -->
  <div class="absolute -top-40 left-1/2 -translate-x-1/2 w-96 h-96 bg-indigo-500/10 rounded-full blur-3xl pointer-events-none"></div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
    
    <div class="text-center max-w-2xl mx-auto mb-16">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-indigo-500/10 border border-indigo-500/20 text-indigo-400 text-xs font-mono mb-4">
        <ShieldCheck class="w-3.5 h-3.5" />
        <span>Authentic Engineering Standards</span>
      </div>
      <h2 class="text-3xl sm:text-4xl font-extrabold text-white tracking-tight">
        Verifiable Proof, Not Empty Claims
      </h2>
      <p class="text-slate-400 text-sm sm:text-base mt-3">
        We prioritize radical transparency and high-assurance systems over stock photos and unverifiable vanity metrics.
      </p>
    </div>

    <!-- Guarantees Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      {proofPoints.map((item) => (
        <div class="glass-card rounded-2xl p-7 border border-white/10 flex flex-col justify-between hover:border-indigo-500/30 transition-all duration-300 group">
          <div>
            <div class="flex items-center justify-between mb-5">
              <div class="w-10 h-10 rounded-xl bg-indigo-500/10 border border-indigo-500/20 flex items-center justify-center text-indigo-400 group-hover:scale-105 transition-transform">
                <item.icon class="w-5 h-5" />
              </div>
              <span class="text-[11px] font-mono px-2 py-0.5 rounded bg-white/5 text-slate-400 border border-white/5">
                {item.badge}
              </span>
            </div>

            <h3 class="text-lg font-bold text-white mb-2 group-hover:text-indigo-300 transition-colors">
              {item.title}
            </h3>

            <p class="text-slate-400 text-xs sm:text-sm leading-relaxed mb-4">
              {item.description}
            </p>
          </div>

          {item.actionLink && (
            <div class="pt-4 border-t border-white/5">
              <a
                href={item.actionLink}
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex items-center gap-1.5 text-xs text-indigo-400 hover:text-indigo-300 font-semibold group/link"
              >
                <span>{item.actionText}</span>
                <ExternalLink class="w-3.5 h-3.5 group-hover/link:translate-x-0.5 transition-transform" />
              </a>
            </div>
          )}
        </div>
      ))}
    </div>

  </div>
</section>
