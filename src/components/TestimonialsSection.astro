---
import { testimonialsData } from '../data/testimonials';
import { Star, Quote } from '@lucide/astro';
---

<section class="py-20 relative overflow-hidden">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
    
    <div class="text-center max-w-2xl mx-auto mb-16">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-emerald-500/10 border border-emerald-500/20 text-emerald-400 text-xs font-mono mb-4">
        <span>Verified Client Feedback</span>
      </div>
      <h2 class="text-3xl sm:text-4xl font-extrabold text-white tracking-tight">
        Trusted by Founders & Engineering Leaders
      </h2>
      <p class="text-slate-400 text-sm sm:text-base mt-3">
        See how Brivrix helps tech startups, venture-backed teams, and businesses achieve their digital product goals.
      </p>
    </div>

    <!-- Testimonials Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
      {testimonialsData.map((item) => (
        <div class="glass-card rounded-2xl p-7 border border-white/10 flex flex-col justify-between relative group hover:border-indigo-500/30 transition-all duration-300">
          
          <div>
            <!-- Star Rating & Project Badge -->
            <div class="flex items-center justify-between mb-4">
              <div class="flex items-center gap-1 text-amber-400">
                {Array.from({ length: item.rating }).map(() => (
                  <Star class="w-4 h-4 fill-amber-400 text-amber-400" />
                ))}
              </div>
              <span class="text-[11px] font-mono px-2 py-0.5 rounded bg-white/5 text-slate-400 border border-white/5">
                {item.projectType}
              </span>
            </div>

            <!-- Quote Text -->
            <p class="text-slate-300 text-sm sm:text-base leading-relaxed italic mb-6">
              "{item.content}"
            </p>
          </div>

          <!-- Client Info -->
          <div class="pt-5 border-t border-white/10 flex items-center gap-3.5">
            <img
              src={item.avatar}
              alt={item.name}
              class="w-11 h-11 rounded-full object-cover border border-white/10"
              loading="lazy"
            />
            <div>
              <h4 class="text-sm font-bold text-white leading-tight">{item.name}</h4>
              <p class="text-xs text-indigo-400 font-medium">{item.role}</p>
              <p class="text-[11px] text-slate-500">{item.company}</p>
            </div>
          </div>

        </div>
      ))}
    </div>

  </div>
</section>

