---
import type { ServiceItem } from '../data/services';
import { ArrowRight, Check, Sparkles, Code2, Palette, Cloud, Zap, Smartphone, Database, FileSpreadsheet } from '@lucide/astro';

interface Props {
  service: ServiceItem;
}

const { service } = Astro.props;
---

<div class="glass-card glass-card-hover rounded-2xl p-6 sm:p-8 flex flex-col justify-between border border-white/10 group relative overflow-hidden">
  
  <!-- Subtle corner ambient glow -->
  <div class="absolute -right-16 -top-16 w-32 h-32 bg-indigo-500/10 rounded-full blur-2xl group-hover:bg-indigo-500/20 transition-all duration-300"></div>

  <div>
    <!-- Top Row: Icon & Badge -->
    <div class="flex items-center justify-between mb-6">
      <div class="w-12 h-12 rounded-xl bg-gradient-to-tr from-sky-500/20 via-indigo-500/20 to-purple-500/20 border border-white/10 flex items-center justify-center text-indigo-400 group-hover:text-sky-300 group-hover:border-indigo-500/40 transition-all duration-300">
        {service.iconName === 'Code2' && <Code2 class="w-6 h-6" />}
        {service.iconName === 'Palette' && <Palette class="w-6 h-6" />}
        {service.iconName === 'Cloud' && <Cloud class="w-6 h-6" />}
        {service.iconName === 'Sparkles' && <Sparkles class="w-6 h-6" />}
        {service.iconName === 'Zap' && <Zap class="w-6 h-6" />}
        {service.iconName === 'Database' && <Database class="w-6 h-6" />}
        {service.iconName === 'FileSpreadsheet' && <FileSpreadsheet class="w-6 h-6" />}
        {service.iconName === 'Smartphone' && <Smartphone class="w-6 h-6" />}
      </div>

      <span class="px-3 py-1 rounded-full text-xs font-medium bg-white/5 text-slate-300 border border-white/10 font-mono">
        {service.badge}
      </span>
    </div>

    <!-- Title & Desc -->
    <h3 class="text-xl font-bold text-white group-hover:text-sky-300 transition-colors mb-3">
      {service.title}
    </h3>
    <p class="text-sm text-slate-400 leading-relaxed mb-6">
      {service.shortDesc}
    </p>

    <!-- Deliverables Checklist -->
    <div class="space-y-2.5 mb-6 pt-4 border-t border-white/5">
      <p class="text-[11px] font-mono uppercase tracking-wider text-slate-500">Key Deliverables</p>
      {service.deliverables.slice(0, 3).map((item) => (
        <div class="flex items-start gap-2.5 text-xs text-slate-300">
          <div class="mt-0.5 rounded-full p-0.5 bg-emerald-500/20 text-emerald-400">
            <Check class="w-3 h-3" />
          </div>
          <span><strong class="text-white font-medium">{item.title}:</strong> {item.desc}</span>
        </div>
      ))}
    </div>

    <!-- Tech Stack Tags -->
    <div class="flex flex-wrap gap-1.5 mb-6">
      {service.techStack.slice(0, 5).map((tech) => (
        <span class="text-[11px] px-2 py-0.5 rounded-md bg-white/[0.04] text-slate-300 border border-white/5">
          {tech}
        </span>
      ))}
      {service.techStack.length > 5 && (
        <span class="text-[11px] px-2 py-0.5 rounded-md bg-white/[0.02] text-slate-500">
          +{service.techStack.length - 5} more
        </span>
      )}
    </div>
  </div>

  <!-- Bottom Pricing & CTA -->
  <div class="pt-5 border-t border-white/10 flex items-center justify-between mt-auto">
    <div>
      <span class="text-[11px] text-slate-500 block uppercase font-mono">Starting at</span>
      <span class="text-xl font-bold text-white font-heading">{service.startingPrice}</span>
      <span class="text-[11px] text-slate-400 block">{service.turnaroundTime}</span>
    </div>

    <a
      href={`/contact?service=${service.id}`}
      class="inline-flex items-center gap-1.5 px-4 py-2 rounded-xl bg-white/5 hover:bg-indigo-600/30 text-white text-xs font-semibold border border-white/10 hover:border-indigo-500/40 transition-all duration-200"
    >
      <span>Inquire</span>
      <ArrowRight class="w-3.5 h-3.5 group-hover:translate-x-0.5 transition-transform" />
    </a>
  </div>

</div>
