---
import { ArrowRight, Sparkles, Code2, Cpu, Zap, Shield, CheckCircle, ArrowUpRight } from '@lucide/astro';
---

<section class="relative pt-12 pb-20 md:pt-20 md:pb-28 overflow-hidden">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
    <div class="flex flex-col items-center text-center max-w-4xl mx-auto space-y-8">
      
      <!-- Top Pill -->
      <div class="inline-flex items-center gap-2.5 px-4 py-1.5 rounded-full bg-white/[0.04] border border-white/10 text-xs sm:text-sm text-slate-300 backdrop-blur-md shadow-lg shadow-black/20 animate-float">
        <span class="flex h-2 w-2 relative">
          <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-sky-400 opacity-75"></span>
          <span class="relative inline-flex rounded-full h-2 w-2 bg-sky-400"></span>
        </span>
        <span class="font-medium text-slate-200">Full-Stack Web, Enterprise DevOps & Digital Growth</span>
        <span class="text-slate-500">|</span>
        <span class="text-indigo-400 font-mono">Accepting Projects</span>
      </div>

      <!-- Main Headline -->
      <h1 class="text-4xl sm:text-6xl lg:text-7xl font-extrabold tracking-tight text-white leading-[1.08] font-heading">
        Turn ambitious ideas into <br class="hidden sm:inline" />
        <span class="gradient-accent">high-performance</span> digital products.
      </h1>

      <!-- Subtitle -->
      <p class="text-lg sm:text-xl text-slate-300 max-w-2xl leading-relaxed font-normal">
        We help founders and businesses build ultra-fast <span class="text-sky-300 font-medium">Astro & WordPress</span> websites, deploy enterprise <span class="text-indigo-300 font-medium">Kubernetes & CI/CD</span> DevOps, and scale with technical SEO & AI automations.
      </p>

      <!-- Action Buttons -->
      <div class="flex flex-col sm:flex-row items-center gap-4 pt-2 w-full sm:w-auto">
        <a
          href="/contact"
          class="w-full sm:w-auto px-8 py-4 rounded-xl bg-gradient-to-r from-sky-500 via-indigo-600 to-purple-600 hover:from-sky-400 hover:to-purple-500 text-white font-semibold text-base transition-all duration-300 shadow-xl shadow-indigo-500/25 hover:shadow-indigo-500/40 hover:-translate-y-0.5 flex items-center justify-center gap-2 group"
        >
          <span>Book a Free Strategy Call</span>
          <ArrowRight class="w-4 h-4 transition-transform group-hover:translate-x-1" />
        </a>

        <a
          href="#estimator"
          class="w-full sm:w-auto px-8 py-4 rounded-xl glass-card hover:bg-white/10 text-white font-medium text-base transition-all duration-200 border border-white/10 hover:border-white/20 flex items-center justify-center gap-2"
        >
          <span>Estimate Your Project</span>
          <span class="text-xs px-2 py-0.5 rounded-full bg-indigo-500/20 text-indigo-300 border border-indigo-500/30 font-mono">Instant</span>
        </a>
      </div>

      <!-- Trust & Key Metrics Bar -->
      <div class="pt-10 w-full">
        <div class="grid grid-cols-2 md:grid-cols-4 gap-4 p-5 rounded-2xl glass-card border border-white/10">
          
          <div class="flex flex-col items-center justify-center p-3 text-center">
            <span class="text-2xl sm:text-3xl font-extrabold text-white font-heading">100<span class="text-sky-400">/</span>100</span>
            <span class="text-xs text-slate-400 font-medium mt-1">Lighthouse Speed</span>
          </div>

          <div class="flex flex-col items-center justify-center p-3 text-center border-l border-white/5">
            <span class="text-2xl sm:text-3xl font-extrabold text-white font-heading">40<span class="text-indigo-400">+</span></span>
            <span class="text-xs text-slate-400 font-medium mt-1">Projects Shipped</span>
          </div>

          <div class="flex flex-col items-center justify-center p-3 text-center border-t md:border-t-0 md:border-l border-white/5">
            <span class="text-2xl sm:text-3xl font-extrabold text-white font-heading">99.99<span class="text-emerald-400">%</span></span>
            <span class="text-xs text-slate-400 font-medium mt-1">Edge Uptime</span>
          </div>

          <div class="flex flex-col items-center justify-center p-3 text-center border-t md:border-t-0 md:border-l border-white/5">
            <span class="text-2xl sm:text-3xl font-extrabold text-white font-heading">100<span class="text-purple-400">%</span></span>
            <span class="text-xs text-slate-400 font-medium mt-1">Code & IP Handover</span>
          </div>

        </div>
      </div>

    </div>
  </div>
</section>

