---
import { pricingTiers } from '../data/pricing';
import { Check, X, ArrowRight, Sparkles } from '@lucide/astro';
---

<section class="py-20 relative overflow-hidden bg-slate-950/40 border-y border-white/5">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
    
    <div class="text-center max-w-2xl mx-auto mb-16">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-indigo-500/10 border border-indigo-500/20 text-indigo-400 text-xs font-mono mb-4">
        <span>Transparent Investment</span>
      </div>
      <h2 class="text-3xl sm:text-5xl font-extrabold text-white tracking-tight">
        Simple, Predictable Pricing Packages
      </h2>
      <p class="text-slate-400 text-base sm:text-lg mt-3">
        No mysterious hourly billing, no surprise invoices. Choose a fixed scope or a continuous dedicated monthly partnership.
      </p>
    </div>

    <!-- Pricing Cards Grid -->
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-8 items-stretch">
      {pricingTiers.map((tier) => (
        <div class={`rounded-3xl p-8 flex flex-col justify-between transition-all duration-300 relative ${
          tier.popular
            ? 'glass-card border-2 border-indigo-500 shadow-2xl shadow-indigo-500/20 lg:-translate-y-2'
            : 'glass-card border border-white/10 hover:border-white/20'
        }`}>
          
          {tier.popular && (
            <div class="absolute -top-3.5 left-1/2 -translate-x-1/2 px-4 py-1 rounded-full bg-gradient-to-r from-sky-400 to-indigo-600 text-white font-bold text-xs uppercase tracking-wider shadow-lg flex items-center gap-1.5">
              <Sparkles class="w-3.5 h-3.5" />
              <span>{tier.badge}</span>
            </div>
          )}

          <div>
            <!-- Tier Header -->
            <div class="mb-6">
              <h3 class="text-2xl font-bold text-white mb-2">{tier.name}</h3>
              <p class="text-xs text-slate-400 leading-relaxed min-h-[36px]">{tier.tagline}</p>
            </div>

            <!-- Price Tag -->
            <div class="py-4 border-y border-white/10 mb-6 flex items-baseline gap-2">
              <span class="text-4xl sm:text-5xl font-black text-white font-heading">{tier.price}</span>
              <span class="text-xs text-slate-400 font-mono">/ {tier.period}</span>
            </div>

            <p class="text-xs text-slate-300 mb-6 leading-relaxed">
              {tier.description}
            </p>

            <!-- Features Included -->
            <div class="space-y-3 mb-8">
              <p class="text-[11px] font-mono uppercase tracking-wider text-slate-400">What's Included</p>
              {tier.features.map((feature) => (
                <div class="flex items-start gap-2.5 text-xs text-slate-200">
                  <div class="mt-0.5 rounded-full p-0.5 bg-emerald-500/20 text-emerald-400 flex-shrink-0">
                    <Check class="w-3.5 h-3.5" />
                  </div>
                  <span>{feature}</span>
                </div>
              ))}

              {tier.notIncluded && tier.notIncluded.map((item) => (
                <div class="flex items-start gap-2.5 text-xs text-slate-500">
                  <div class="mt-0.5 rounded-full p-0.5 bg-white/5 text-slate-500 flex-shrink-0">
                    <X class="w-3.5 h-3.5" />
                  </div>
                  <span>{item}</span>
                </div>
              ))}
            </div>
          </div>

          <!-- Bottom Action & Delivery Estimate -->
          <div class="pt-6 border-t border-white/10 mt-auto">
            <div class="text-[11px] text-slate-400 font-mono mb-4 text-center">
              Delivery: <span class="text-white font-semibold">{tier.deliveryEstimate}</span>
            </div>

            <a
              href={tier.ctaLink}
              class={`w-full py-3.5 px-4 rounded-xl font-semibold text-sm transition-all duration-200 flex items-center justify-center gap-2 ${
                tier.popular
                  ? 'bg-gradient-to-r from-sky-500 via-indigo-600 to-purple-600 hover:from-sky-400 hover:to-purple-500 text-white shadow-lg shadow-indigo-500/30'
                  : 'bg-white/5 hover:bg-white/10 text-white border border-white/10'
              }`}
            >
              <span>{tier.ctaText}</span>
              <ArrowRight class="w-4 h-4" />
            </a>
          </div>

        </div>
      ))}
    </div>

  </div>
</section>

