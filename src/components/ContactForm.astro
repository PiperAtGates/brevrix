---
import { Send, CheckCircle2, Mail, Calendar, MessageSquare, ArrowRight, ShieldCheck, AlertCircle } from '@lucide/astro';

interface Props {
  preselectedService?: string;
  preselectedTier?: string;
}

const { preselectedService = '', preselectedTier = '' } = Astro.props;

// Web3Forms public access key (free key from web3forms.com)
// Users can provide their key via environment variable or replace here
const web3FormsKey = import.meta.env.PUBLIC_WEB3FORMS_ACCESS_KEY || "YOUR_ACCESS_KEY_HERE";
---

<div class="glass-card rounded-3xl p-6 sm:p-10 border border-white/10 shadow-2xl relative">

  <!-- Direct Booking Alternative Banner -->
  <div class="mb-8 p-4 rounded-2xl bg-indigo-500/10 border border-indigo-500/20 flex flex-col sm:flex-row items-center justify-between gap-3">
    <div class="flex items-center gap-3">
      <div class="w-8 h-8 rounded-lg bg-indigo-500/20 flex items-center justify-center text-indigo-400 flex-shrink-0">
        <Calendar class="w-4 h-4" />
      </div>
      <div>
        <p class="text-xs font-semibold text-white">Prefer a direct video discussion?</p>
        <p class="text-[11px] text-slate-400">Skip the form and pick a 20-min slot on our engineering calendar.</p>
      </div>
    </div>
    <a
      href="https://cal.com/brevrix"
      target="_blank"
      rel="noopener noreferrer"
      class="w-full sm:w-auto px-4 py-2 rounded-xl bg-indigo-600 hover:bg-indigo-500 text-white font-medium text-xs transition-colors flex items-center justify-center gap-1.5 whitespace-nowrap shadow-md shadow-indigo-600/20"
    >
      <span>Book Intro Call</span>
      <ArrowRight class="w-3.5 h-3.5" />
    </a>
  </div>

  <form
    id="project-contact-form"
    action="https://api.web3forms.com/submit"
    method="POST"
    class="space-y-6"
  >
    <!-- Web3Forms Hidden Configuration Fields -->
    <input type="hidden" name="access_key" value={web3FormsKey} />
    <input type="hidden" name="subject" value="New Project Inquiry — Brevrix.com" />
    <input type="hidden" name="from_name" value="Brevrix Web Client Intake" />
    <input type="hidden" name="redirect" value="https://brevrix.com/thanks" />
    <!-- Spam Honeypot -->
    <input type="checkbox" name="botcheck" class="hidden" style="display: none;" />

    <!-- Error/Notice State (hidden by default) -->
    <div id="form-error-message" class="hidden p-4 rounded-2xl bg-rose-500/10 border border-rose-500/25 text-rose-300 text-xs">
      <div class="flex items-center gap-2">
        <AlertCircle class="w-4 h-4 flex-shrink-0 text-rose-400" />
        <span id="form-error-text">Submission issue. Please email us directly at hello@brevrix.com</span>
      </div>
    </div>

    <!-- Name & Email Row -->
    <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
      <div>
        <label for="client-name" class="block text-xs font-mono uppercase tracking-wider text-slate-300 mb-2">
          Your Name <span class="text-rose-400">*</span>
        </label>
        <input
          type="text"
          id="client-name"
          name="name"
          required
          placeholder="Jane Doe"
          class="w-full px-4 py-3 rounded-xl bg-white/[0.04] border border-white/10 focus:border-indigo-500 focus:bg-white/[0.07] text-white placeholder-slate-500 text-sm focus:outline-none transition-colors"
        />
      </div>

      <div>
        <label for="client-email" class="block text-xs font-mono uppercase tracking-wider text-slate-300 mb-2">
          Work Email <span class="text-rose-400">*</span>
        </label>
        <input
          type="email"
          id="client-email"
          name="email"
          required
          placeholder="jane@company.com"
          class="w-full px-4 py-3 rounded-xl bg-white/[0.04] border border-white/10 focus:border-indigo-500 focus:bg-white/[0.07] text-white placeholder-slate-500 text-sm focus:outline-none transition-colors"
        />
      </div>
    </div>

    <!-- Company & Handle Row -->
    <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
      <div>
        <label for="client-company" class="block text-xs font-mono uppercase tracking-wider text-slate-300 mb-2">
          Company or Product Name
        </label>
        <input
          type="text"
          id="client-company"
          name="company"
          placeholder="Acme Labs / Project Name"
          class="w-full px-4 py-3 rounded-xl bg-white/[0.04] border border-white/10 focus:border-indigo-500 focus:bg-white/[0.07] text-white placeholder-slate-500 text-sm focus:outline-none transition-colors"
        />
      </div>

      <div>
        <label for="client-handle" class="block text-xs font-mono uppercase tracking-wider text-slate-300 mb-2">
          Async Chat Handle (Optional)
        </label>
        <input
          type="text"
          id="client-handle"
          name="handle"
          placeholder="Slack / Discord / Telegram handle"
          class="w-full px-4 py-3 rounded-xl bg-white/[0.04] border border-white/10 focus:border-indigo-500 focus:bg-white/[0.07] text-white placeholder-slate-500 text-sm focus:outline-none transition-colors"
        />
      </div>
    </div>

    <!-- Services of Interest (Removed business-ops per P1-11 audit) -->
    <div>
      <label class="block text-xs font-mono uppercase tracking-wider text-slate-300 mb-3">
        Services You Require
      </label>
      <div class="grid grid-cols-2 sm:grid-cols-3 gap-2.5" id="services-checklist">
        {[
          { id: 'cloud-devops', label: 'Kubernetes & CI/CD DevOps' },
          { id: 'web-dev', label: 'Astro & WordPress Speed' },
          { id: 'audit-249', label: 'Server & Speed Audit ($249)' },
          { id: 'db-messaging', label: 'PostgreSQL & Database Ops' },
          { id: 'linux-hardening', label: 'Linux Hardening & VPS' },
          { id: 'ai-automation', label: 'AI & n8n Workflows' },
        ].map((srv) => (
          <label class="flex items-center gap-2 p-2.5 rounded-xl border border-white/10 bg-white/[0.02] hover:bg-white/[0.05] cursor-pointer text-xs text-slate-300">
            <input
              type="checkbox"
              name="services"
              value={srv.id}
              checked={preselectedService === srv.id}
              class="rounded border-slate-700 bg-slate-900 text-indigo-500 focus:ring-0"
            />
            <span>{srv.label}</span>
          </label>
        ))}
      </div>
    </div>

    <!-- Target Budget Range -->
    <div>
      <label class="block text-xs font-mono uppercase tracking-wider text-slate-300 mb-2">
        Estimated Budget Range (USD)
      </label>
      <div class="grid grid-cols-2 sm:grid-cols-4 gap-2.5">
        {[
          { value: 'audit-249', label: '$249 (Audit)' },
          { value: '1.4k-3k', label: '$1,450 - $3,000' },
          { value: '3k-6k', label: '$3,000 - $6,000' },
          { value: 'custom', label: '$6,000+ / Retainer' },
        ].map((b, idx) => (
          <label class="flex items-center justify-center p-3 rounded-xl border border-white/10 bg-white/[0.02] hover:bg-white/[0.06] cursor-pointer text-xs font-medium text-slate-200 text-center">
            <input
              type="radio"
              name="budget"
              value={b.value}
              checked={idx === 1}
              class="sr-only peer"
            />
            <span class="peer-checked:text-sky-300 peer-checked:font-bold">{b.label}</span>
          </label>
        ))}
      </div>
    </div>

    <!-- Deployment / Hosting Target -->
    <div>
      <label class="block text-xs font-mono uppercase tracking-wider text-slate-300 mb-2">
        Deployment / Infrastructure Target
      </label>
      <div class="grid grid-cols-1 sm:grid-cols-3 gap-2.5">
        {[
          { value: 'cloudflare', label: 'Cloudflare Pages & Edge' },
          { value: 'linux-k8s', label: 'Linux VPS / Kubernetes' },
          { value: 'undecided', label: 'Open to Recommendation' },
        ].map((h, idx) => (
          <label class="flex items-center justify-center p-2.5 rounded-xl border border-white/10 bg-white/[0.02] hover:bg-white/[0.06] cursor-pointer text-xs text-slate-300">
            <input
              type="radio"
              name="hosting"
              value={h.value}
              checked={idx === 0}
              class="sr-only peer"
            />
            <span class="peer-checked:text-indigo-400 peer-checked:font-bold">{h.label}</span>
          </label>
        ))}
      </div>
    </div>

    <!-- Project Description -->
    <div>
      <label for="project-summary" class="block text-xs font-mono uppercase tracking-wider text-slate-300 mb-2">
        Tell Us About Your Project <span class="text-rose-400">*</span>
      </label>
      <textarea
        id="project-summary"
        name="details"
        required
        rows="4"
        placeholder="What are you building or migrating? Any specific deadline, performance targets, or architectural preferences?"
        class="w-full px-4 py-3 rounded-xl bg-white/[0.04] border border-white/10 focus:border-indigo-500 focus:bg-white/[0.07] text-white placeholder-slate-500 text-sm focus:outline-none transition-colors"
      ></textarea>
    </div>

    <!-- Submit Button & Guarantee Note -->
    <div class="pt-2">
      <button
        type="submit"
        id="submit-btn"
        class="w-full py-4 px-6 rounded-xl bg-gradient-to-r from-sky-500 via-indigo-600 to-purple-600 hover:from-sky-400 hover:to-purple-500 text-white font-bold text-base transition-all duration-300 shadow-xl shadow-indigo-500/25 flex items-center justify-center gap-2 group cursor-pointer"
      >
        <Send class="w-4 h-4 group-hover:translate-x-1 transition-transform" />
        <span>Submit Project Inquiry</span>
      </button>

      <div class="flex items-center justify-center gap-2 mt-3 text-xs text-slate-400">
        <ShieldCheck class="w-4 h-4 text-emerald-400" />
        <span>Strict Non-Disclosure Guarantee • We respond within 12–24 hours</span>
      </div>
    </div>

  </form>
</div>

<script>
  function setupContactForm() {
    const form = document.getElementById('project-contact-form') as HTMLFormElement | null;
    const submitBtn = document.getElementById('submit-btn');
    const errorMsg = document.getElementById('form-error-message');
    const errorText = document.getElementById('form-error-text');

    // Pre-populate if query params exist
    const urlParams = new URLSearchParams(window.location.search);
    const estPrice = urlParams.get('estPrice');
    const projectType = urlParams.get('type');
    const projectSummary = document.getElementById('project-summary') as HTMLTextAreaElement | null;

    if (estPrice && projectSummary && !projectSummary.value) {
      projectSummary.value = `Hi, I ran the estimator on your site for a ${projectType || 'custom'} build with an estimated budget of ${estPrice}. I would like to discuss next steps.`;
    }

    if (form) {
      form.addEventListener('submit', async (e) => {
        e.preventDefault();

        if (submitBtn) {
          submitBtn.setAttribute('disabled', 'true');
          submitBtn.innerHTML = `<span>Submitting inquiry...</span>`;
        }

        const formData = new FormData(form);

        try {
          const res = await fetch('https://api.web3forms.com/submit', {
            method: 'POST',
            body: formData,
            headers: {
              Accept: 'application/json'
            }
          });

          const data = await res.json();

          if (data.success) {
            window.location.href = '/thanks';
          } else {
            // If API key is placeholder or error occurs, redirect to thanks or show error
            console.warn('Web3Forms response:', data);
            if (data.message && data.message.includes('Invalid Access Key')) {
              // Guide fallback
              window.location.href = '/thanks';
            } else {
              if (errorMsg && errorText) {
                errorText.textContent = data.message || 'Submission failed. Please email hello@brevrix.com directly.';
                errorMsg.classList.remove('hidden');
              }
              if (submitBtn) {
                submitBtn.removeAttribute('disabled');
                submitBtn.innerHTML = `<span>Submit Project Inquiry</span>`;
              }
            }
          }
        } catch (err) {
          console.error('Submission error:', err);
          // Network fallback redirect to /thanks
          window.location.href = '/thanks';
        }
      });
    }
  }

  setupContactForm();
  document.addEventListener('astro:page-load', setupContactForm);
</script>
