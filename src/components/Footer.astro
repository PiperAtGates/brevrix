---
import { ArrowUpRight, Mail, ShieldCheck, Zap, Globe, Sparkles } from '@lucide/astro';

const services = [
  { name: 'Enterprise DevOps & K8s', href: '/services#cloud-devops' },
  { name: 'Modern Web & WordPress', href: '/services#web-dev' },
  { name: 'Database & Messaging', href: '/services#db-messaging' },
  { name: 'AI & Workflow Automation', href: '/services#ai-automation' },
  { name: 'Digital Marketing & SEO (GEO)', href: '/services#digital-marketing-seo' },
  { name: 'Business Ops & Reporting', href: '/services#business-ops' },
];

const navigation = [
  { name: 'Home', href: '/' },
  { name: 'Services Directory', href: '/services' },
  { name: 'Portfolio & Case Studies', href: '/work' },
  { name: 'Technical Blog & Guides', href: '/blog' },
  { name: 'About Leadership', href: '/about' },
  { name: 'Pricing & Estimator', href: '/pricing' },
  { name: 'Contact & Inquiry', href: '/contact' },
  { name: 'Privacy Policy', href: '/privacy-policy' },
];
---

<footer class="relative border-t border-white/10 bg-slate-950/80 pt-16 pb-12 overflow-hidden">
  <!-- Subtle ambient glow in footer -->
  <div class="ambient-glow -bottom-40 left-1/3 w-96 h-96 bg-indigo-600/20"></div>
  <div class="ambient-glow -bottom-40 right-1/4 w-96 h-96 bg-cyan-600/15"></div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-5 gap-10 pb-12 border-b border-white/10">
      
      <!-- Brand & Mission Column (Span 2) -->
      <div class="lg:col-span-2 space-y-5">
        <div class="flex items-center gap-3">
          <div class="w-10 h-10 rounded-xl bg-gradient-to-tr from-sky-400 via-indigo-500 to-purple-600 p-[1.5px] shadow-lg shadow-indigo-500/20">
            <div class="w-full h-full bg-slate-950 rounded-[10px] flex items-center justify-center">
              <span class="font-black text-xl bg-gradient-to-tr from-sky-400 via-indigo-300 to-purple-400 bg-clip-text text-transparent">B</span>
            </div>
          </div>
          <div>
            <span class="font-extrabold text-2xl tracking-tight text-white">BREVRIX<span class="text-indigo-400">.</span></span>
            <p class="text-xs text-slate-400 font-mono">Full-Stack Web, DevOps & Digital Growth Studio</p>
          </div>
        </div>

        <p class="text-slate-400 text-sm leading-relaxed max-w-sm">
          Combining enterprise Linux & Kubernetes infrastructure engineering, ultra-fast Astro & WordPress development, AI automations, and transparent business operations.
        </p>

        <!-- Live Deployment Badges -->
        <div class="pt-2 flex flex-wrap items-center gap-3">
          <div class="flex items-center gap-1.5 px-3 py-1 rounded-lg bg-white/[0.04] border border-white/10 text-xs text-slate-300">
            <span class="w-2 h-2 rounded-full bg-cyan-400"></span>
            <span>Cloudflare Edge Ready</span>
          </div>
          <div class="flex items-center gap-1.5 px-3 py-1 rounded-lg bg-white/[0.04] border border-white/10 text-xs text-slate-300">
            <span class="w-2 h-2 rounded-full bg-emerald-400"></span>
            <span>Kubernetes & GitOps Tested</span>
          </div>
          <div class="flex items-center gap-1.5 px-3 py-1 rounded-lg bg-white/[0.04] border border-white/10 text-xs text-slate-300">
            <span class="w-2 h-2 rounded-full bg-indigo-400"></span>
            <span>Astro Powered</span>
          </div>
        </div>
      </div>

      <!-- Services Column -->
      <div class="space-y-4">
        <h3 class="text-xs font-semibold uppercase tracking-wider text-slate-300 font-mono">Services</h3>
        <ul class="space-y-2.5">
          {services.map((item) => (
            <li>
              <a
                href={item.href}
                class="text-sm text-slate-400 hover:text-white transition-colors duration-200 inline-flex items-center gap-1 group"
              >
                <span>{item.name}</span>
                <span class="text-slate-600 group-hover:text-indigo-400 transition-colors">›</span>
              </a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Quick Links -->
      <div class="space-y-4">
        <h3 class="text-xs font-semibold uppercase tracking-wider text-slate-300 font-mono">Quick Navigation</h3>
        <ul class="space-y-2.5">
          {navigation.map((item) => (
            <li>
              <a
                href={item.href}
                class="text-sm text-slate-400 hover:text-white transition-colors duration-200"
              >
                {item.name}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Direct Contact & Channels -->
      <div class="space-y-4">
        <h3 class="text-xs font-semibold uppercase tracking-wider text-slate-300 font-mono">Connect & Hire</h3>
        <p class="text-xs text-slate-400">
          Ready to discuss your infrastructure or web project? Reach out directly:
        </p>
        <a
          href="mailto:taanvir1839@gmail.com"
          class="flex items-center gap-2 text-sm text-sky-400 hover:text-sky-300 transition-colors font-mono break-all"
        >
          <Mail class="w-4 h-4 flex-shrink-0" />
          <span>taanvir1839@gmail.com</span>
        </a>
        
        <!-- Social links with clean robust SVGs -->
        <div class="flex items-center gap-2.5 pt-2">
          <!-- GitHub (Sadia's profile link) -->
          <a
            href="https://github.com/sadia-lubna"
            target="_blank"
            rel="noopener noreferrer"
            class="p-2.5 rounded-xl bg-white/5 hover:bg-white/10 text-slate-400 hover:text-white transition-colors border border-white/5"
            aria-label="GitHub"
          >
            <svg class="w-4 h-4 fill-currentColor" viewBox="0 0 24 24">
              <path fill-rule="evenodd" clip-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.53 1.032 1.53 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z"/>
            </svg>
          </a>
          <!-- LinkedIn (Sadia's profile link) -->
          <a
            href="https://www.linkedin.com/in/sadia-lubna/"
            target="_blank"
            rel="noopener noreferrer"
            class="p-2.5 rounded-xl bg-white/5 hover:bg-white/10 text-slate-400 hover:text-white transition-colors border border-white/5"
            aria-label="LinkedIn"
          >
            <svg class="w-4 h-4 fill-currentColor" viewBox="0 0 24 24">
              <path d="M19 3a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h14m-.5 15.5v-5.3a3.26 3.26 0 0 0-3.26-3.26c-.85 0-1.84.52-2.28 1.3v-1.11h-2.79v8.37h2.79v-4.93c0-.77.62-1.4 1.39-1.4a1.4 1.4 0 0 1 1.4 1.4v4.93h2.75M6.46 10.9h2.79v8.37H6.46V10.9M7.86 6.5a1.63 1.63 0 1 0 0 3.26 1.63 1.63 0 0 0 0-3.26z"/>
            </svg>
          </a>
        </div>

        <div class="pt-2">
          <a
            href="/contact"
            class="inline-flex items-center gap-1.5 text-xs text-indigo-400 hover:text-indigo-300 font-medium"
          >
            <span>Book a Technical Discovery Call</span>
            <ArrowUpRight class="w-3.5 h-3.5" />
          </a>
        </div>
      </div>

    </div>

    <!-- Bottom Bar -->
    <div class="pt-8 flex flex-col sm:flex-row items-center justify-between gap-4 text-xs text-slate-500">
      <p>© {new Date().getFullYear()} Brevrix (brevrix.com). All rights reserved.</p>
      
      <div class="flex items-center gap-6">
        <span class="flex items-center gap-2">
          <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span>
          <span class="text-slate-400">All Systems Operational</span>
        </span>
        <a href="/pricing" class="hover:text-slate-400 transition-colors">Pricing</a>
        <a href="/privacy-policy" class="hover:text-slate-400 transition-colors">Privacy Policy</a>
        <a href="/contact" class="hover:text-slate-400 transition-colors">Contact</a>
      </div>
    </div>
  </div>
</footer>
