---
import { ArrowRight, Sparkles, MessageCircle, Calendar } from '@lucide/astro';
---

<section class="py-20 relative overflow-hidden">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
    <div class="relative rounded-3xl overflow-hidden p-8 sm:p-14 border border-white/10 shadow-2xl bg-gradient-to-br from-indigo-950/80 via-slate-900/90 to-slate-950">
      
      <!-- Ambient light orbs inside the banner -->
      <div class="absolute -right-20 -top-20 w-80 h-80 bg-sky-500/20 rounded-full blur-3xl pointer-events-none"></div>
      <div class="absolute -left-20 -bottom-20 w-80 h-80 bg-purple-600/20 rounded-full blur-3xl pointer-events-none"></div>

      <div class="relative z-10 flex flex-col lg:flex-row items-center justify-between gap-8 text-center lg:text-left">
        
        <div class="max-w-2xl space-y-4">
          <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-white/10 text-xs font-mono text-indigo-300">
            <Sparkles class="w-3.5 h-3.5 text-sky-400" />
            <span>Ready to ship your digital vision?</span>
          </div>

          <h2 class="text-3xl sm:text-4xl lg:text-5xl font-extrabold text-white tracking-tight leading-tight">
            Let's build something exceptional together.
          </h2>

          <p class="text-slate-300 text-sm sm:text-base leading-relaxed">
            Whether you need a high-converting web platform, enterprise Kubernetes & CI/CD automation, or an edge cloud migration, our team is ready to help you execute.
          </p>
        </div>

        <div class="flex flex-col sm:flex-row items-center gap-4 flex-shrink-0">
          <a
            href="/contact"
            class="w-full sm:w-auto px-8 py-4 rounded-xl bg-gradient-to-r from-sky-400 via-indigo-500 to-purple-600 hover:from-sky-300 hover:to-purple-500 text-white font-bold text-base transition-all duration-300 shadow-xl shadow-indigo-500/30 flex items-center justify-center gap-2 group"
          >
            <span>Start Your Project</span>
            <ArrowRight class="w-4 h-4 group-hover:translate-x-1 transition-transform" />
          </a>

          <a
            href="/pricing"
            class="w-full sm:w-auto px-6 py-4 rounded-xl bg-white/5 hover:bg-white/10 text-white font-medium text-sm transition-all border border-white/10 text-center"
          >
            <span>View Packages</span>
          </a>
        </div>

      </div>

    </div>
  </div>
</section>

